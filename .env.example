# Copy to .env.local for local development. For deployed environments
# (Vercel), these must be set separately in the project's Environment
# Variables settings -- nothing here propagates automatically, and there is
# no committed source of truth for them beyond this file. This file exists
# because ADMIN_EMAILS was previously only ever set in a git-ignored
# .env.local and silently never made it into production.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key -- server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Strava OAuth (required for /auth/strava) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# 32-byte key (base64-encoded), used to encrypt stored Strava OAuth tokens
# at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- AI (required for the coaching assistant / admin structured-output calls) ---
# Free tier via console.groq.com -- see src/lib/ai/model.ts for which models
# this project uses and why.
GROQ_API_KEY=

# --- Admin access (required to unlock /admin) ---
# Comma-separated allowlist of emails recognized as site admin. Must match
# the signed-in Supabase account's email exactly (case-insensitive).
# Missing or empty means NO ONE can access /admin, including you.
ADMIN_EMAILS=
